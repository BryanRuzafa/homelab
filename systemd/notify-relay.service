[Unit]
Description=Avisos por WhatsApp (asistente WAHA + respaldo CallMeBot)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/notify-relay.env
ExecStart=/usr/bin/python3 -u /usr/local/sbin/notify-relay.py
Restart=always
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
