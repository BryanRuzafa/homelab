   "name": "Leer Google Calendar",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    480,
    220
   ],
   "id": "23b0a89f-c460-4edf-8cd3-fd189aa9a4fd",
   "credentials": {
    "googleCalendarOAuth2Api": {
     "id": "CREDENCIAL_GOOGLE_CALENDAR",
     "name": "Google Calendar account"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "const r = $input.first().json;\nif (!Array.isArray(r.items)) throw new Error('Respuesta inesperada de Google Calendar: ' + JSON.stringify(r).slice(0, 300));\nconst from = $now.minus({ days: 30 }).toFormat('yyyy-MM-dd');\nconst to = $now.plus({ days: 180 }).toFormat('yyyy-MM-dd');\nconst events = r.items.filter(e => e.status !== 'cancelled' && e.start).map(e => {\n  const s = e.start.dateTime || e.start.date;\n  const en = (e.end && (e.end.dateTime || e.end.date)) || '';\n  const timed = !!e.start.dateTime;\n  return { gcal_id: e.id, title: e.summary || '(sin título)', date: s.slice(0, 10),\n           time: timed ? s.slice(11, 16) : null, end_time: timed && en ? en.slice(11, 16) : null };\n});\nreturn [{ json: { from, to, events } }];"
   },
