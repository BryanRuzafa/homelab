  {
   "parameters": {
    "jsCode": "const e = $json;\nconst pad = n => String(n).padStart(2, '0');\nconst nextDay = d => { const x = new Date(d + 'T00:00:00Z'); x.setUTCDate(x.getUTCDate() + 1); return x.toISOString().slice(0, 10); };\nconst body = { summary: e.title };\nif (e.notes) body.description = e.notes;\nif (e.time) {\n  let end = e.end_time && e.end_time > e.time ? e.end_time : pad(Math.min(+e.time.slice(0, 2) + 1, 23)) + e.time.slice(2);\n  if (end <= e.time) end = '23:59';\n  body.start = { dateTime: `${e.date}T${e.time}:00`, timeZone: 'Europe/Madrid' };\n  body.end = { dateTime: `${e.date}T${end}:00`, timeZone: 'Europe/Madrid' };\n} else {\n  body.start = { date: e.date };\n  body.end = { date: nextDay(e.date) };\n}\nreturn { json: { agenda_id: e.id, gcal_id: e.gcal_id || '', body } };",
    "mode": "runOnceForEachItem"
   },
