  {
   "parameters": {
    "jsCode": "const s = $getWorkflowStaticData('global');\nconst e = $json;\nconst wf = (e.workflow && e.workflow.name) || 'flujo';\nconst key = wf + '|' + ((e.execution && e.execution.error && e.execution.error.message) || '').slice(0, 80);\nconst now = Date.now();\ns.sent = s.sent || {};\nif (s.sent[key] && now - s.sent[key] < 6 * 3600 * 1000) return [];\ns.sent[key] = now;\nconst msg = (e.execution && e.execution.error && e.execution.error.message) || 'Error desconocido';\nreturn [{ json: { text: `⚠️ *n8n: falló «${wf}»*\\n${msg.slice(0, 300)}\\n(no repetiré este aviso en 6 h)` } }];"
   },
